erDiagram
    USERS ||--o| BORROWERS : has
    BORROWERS ||--o{ LOANS : has
    BOOKS ||--o{ LOANS : has
    GENRES ||--o{ BOOKS : has
    BOOKS ||--o{ BOOK_AUTHORS : has
    AUTHORS ||--o{ BOOK_AUTHORS : has

    USERS {
        int id PK
        string email
        string name
        timestamp created_at
    }

    BORROWERS {
        int id PK
        int user_id FK
    }

    GENRES {
        int id PK
        string name
    }

    AUTHORS {
        int id PK
        string name
    }

    BOOKS {
        int id PK
        int genre_id FK
        string title
    }

    BOOK_AUTHORS {
        int id PK
        int book_id FK
        int author_id FK
    }

    LOANS {
        int id PK
        int borrower_id FK
        int book_id FK
        date loan_date
        date due_date
        date return_date
    }
